# Contoh Environment Apache Superset 6.1.0 - Modern Civic Dual-Mode v3
# Salin file ini menjadi `superset/docker/.env-non-dev` lalu ganti seluruh nilai CHANGE_ME.

COMPOSE_PROJECT_NAME=superset-modern

# Superset Application & Security (WAJIB DIGANTI)
SUPERSET_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_42
# SUPERSET_PREVIOUS_SECRET_KEY=
SUPERSET_PORT=8088
FLASK_ENV=production
SUPERSET_ENV=production
SUPERSET_LOAD_EXAMPLES=no
CYPRESS_CONFIG=false
PYTHONPATH=/app/docker/pythonpath_dev:/app/pythonpath
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Metadata Database (PostgreSQL)
DATABASE_DIALECT=postgresql+psycopg2
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_DB=superset
DATABASE_USER=superset
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD

# PostgreSQL Container Init
POSTGRES_DB=superset
POSTGRES_USER=superset
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# Redis Cache & Celery Broker
REDIS_HOST=redis
REDIS_PORT=6379
# Opsional: REDIS_CELERY_DB=0
# Opsional: REDIS_RESULTS_DB=1

# Mapbox (opsional)
MAPBOX_API_KEY=CHANGE_ME_MAPBOX_TOKEN

# Custom Branding & Logo (opsional)
# Taruh file logo/favicon apapun (.png/.svg/.webp/.ico) di superset/docker/assets/branding/
# lalu arahkan path di bawah ini ke /static/assets/images/branding/<nama-file>.
SUPERSET_APP_NAME=Executive Analytics
SUPERSET_APP_ICON=/static/assets/images/superset-logo-horiz.png
SUPERSET_FAVICON_URL=/static/assets/images/favicon.png
# SUPERSET_APP_ICON_WIDTH=135
# SUPERSET_LOGO_TOOLTIP=Executive Analytics
# SUPERSET_LOGO_RIGHT_TEXT=Executive Analytics

# Kebijakan Iframe Embedding & CSP (opsional, pisahkan dengan spasi atau koma)
# SUPERSET_EMBED_ALLOWED_ORIGINS='self' https://dashboard.contoh.go.id
# SUPERSET_FRAME_SRC='self' blob: data:
